{
  "expo": {
    "name": "PingMe",
    "slug": "pingme",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "pingme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pingme.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PingMe uses your location to show nearby posts and people within ~250m.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PingMe uses your location in the background while you're Available so nearby people can see you're open to connect.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.pingme.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PingMe uses your location to show nearby posts and people within ~250m.",
          "locationAlwaysAndWhenInUsePermission": "PingMe uses your location in the background while you're Available so nearby people can see you're open to connect.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "20b0977f-0950-443c-9465-fec3e8dca603"
      }
    },
    "owner": "hostyler-group"
  }
}
