# REST API base URL (include /v1)
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Public invite/share links (no /v1). Optional: defaults to API URL with /v1 stripped.
EXPO_PUBLIC_INVITE_URL=https://pingme.hostyler.cloud

# WebSocket URL for realtime features
EXPO_PUBLIC_WS_URL=ws://localhost:3000/ws

# App environment label (development | staging | production)
EXPO_PUBLIC_ENV=development

# Sentry crash reporting. Leave empty to disable; set DSN when you want error tracking.
EXPO_PUBLIC_SENTRY_DSN=

# Mapbox public token for Events maps (pk.* only — never use sk.* here)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
