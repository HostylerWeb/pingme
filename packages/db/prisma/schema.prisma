generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  phone
  google
  apple
}

enum UserStatus {
  active
  suspended
  deleted
  pending_verification
}

enum AvatarType {
  photo
  generated
}

enum Gender {
  male
  female
  transgender
  other
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String?      @unique
  phone         String?      @unique
  passwordHash  String?      @map("password_hash")
  authProvider  AuthProvider @default(email) @map("auth_provider")
  status        UserStatus   @default(pending_verification)
  emailVerified Boolean      @default(false) @map("email_verified")
  phoneVerified Boolean      @default(false) @map("phone_verified")
  isAvailable          Boolean      @default(false) @map("is_available")
  requiresAdminReview  Boolean      @default(false) @map("requires_admin_review")
  lastSeenAt           DateTime?    @map("last_seen_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  deletionScheduledAt DateTime? @map("deletion_scheduled_at")

  profile              Profile?
  settings             UserSettings?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  otpCodes             OtpCode[]
  presenceSession      PresenceSession?
  wallPosts            WallPost[]
  wallReplies          WallReply[]
  blocksInitiated      Block[]            @relation("BlocksInitiated")
  blocksReceived       Block[]            @relation("BlocksReceived")
  devices              Device[]
  securityEvents       UserSecurityEvent[]
  icebreakerSessions        IcebreakerSession[]
  icebreakerInterestsSent   IcebreakerInterest[] @relation("IcebreakerInterestFrom")
  icebreakerInterestsReceived IcebreakerInterest[] @relation("IcebreakerInterestTo")
  matchesAsUserA       Match[]             @relation("MatchUserA")
  matchesAsUserB       Match[]             @relation("MatchUserB")
  messagesSent         Message[]
  chatParticipantStates ChatParticipantState[]
  reportsFiled         Report[]            @relation("ReportsFiled")
  reportsReceived      Report[]            @relation("ReportsReceived")
  verifications        Verification[]
  subscription         Subscription?
  events               Event[]
  eventRsvps           EventRsvp[]
  eventComments        EventComment[]

  @@map("users")
}

model Profile {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @unique @map("user_id") @db.Uuid
  displayName  String     @map("display_name") @db.VarChar(50)
  bio          String?    @db.VarChar(300)
  avatarType   AvatarType @default(generated) @map("avatar_type")
  avatarUrl    String?    @map("avatar_url")
  avatarConfig Json?      @map("avatar_config")
  dateOfBirth  DateTime   @map("date_of_birth") @db.Date
  gender       Gender?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserSettings {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @unique @map("user_id") @db.Uuid
  radiusMeters        Int     @default(250) @map("radius_meters")
  quietMode           Boolean @default(false) @map("quiet_mode")
  showDistanceBucket  Boolean @default(true) @map("show_distance_bucket")
  allowPushReplies    Boolean @default(true) @map("allow_push_replies")
  allowPushChat       Boolean @default(true) @map("allow_push_chat")
  allowPushIcebreaker Boolean @default(true) @map("allow_push_icebreaker")
  allowPushIcebreakerNearby Boolean @default(true) @map("allow_push_icebreaker_nearby")
  allowPushEventsNearby Boolean @default(true) @map("allow_push_events_nearby")
  showReadReceipts    Boolean @default(false) @map("show_read_receipts")
  language            String  @default("en") @db.VarChar(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum OtpType {
  email_verify
  phone_verify
}

model OtpCode {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         OtpType
  codeHash     String    @map("code_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([codeHash])
  @@map("otp_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum WallPostStatus {
  active
  hidden
  deleted
  moderated
}

enum WallReplyStatus {
  active
  hidden
  deleted
}

enum DevicePlatform {
  ios
  android
}

model PresenceSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  isActive            Boolean   @default(false) @map("is_active")
  latitude            Float?
  longitude           Float?
  fuzzyLat            Float?    @map("fuzzy_lat")
  fuzzyLng            Float?    @map("fuzzy_lng")
  locationAccuracy    Float?    @map("location_accuracy")
  locationUpdatedAt   DateTime? @map("location_updated_at")
  startedAt           DateTime  @default(now()) @map("started_at")
  endedAt             DateTime? @map("ended_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@map("presence_sessions")
}

model WallPost {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  content   String         @db.VarChar(500)
  latitude  Float
  longitude Float
  showPhoto Boolean        @default(false) @map("show_photo")
  status    WallPostStatus @default(active)
  replyCount Int           @default(0) @map("reply_count")
  createdAt DateTime       @default(now()) @map("created_at")
  expiresAt DateTime?      @map("expires_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies WallReply[]

  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([status])
  @@map("wall_posts")
}

model WallReply {
  id        String          @id @default(uuid()) @db.Uuid
  postId    String          @map("post_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  content   String          @db.VarChar(300)
  status    WallReplyStatus @default(active)
  createdAt DateTime        @default(now()) @map("created_at")

  post WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("wall_replies")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Device {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  platform      DevicePlatform
  pushToken     String         @map("push_token")
  deviceId      String?        @map("device_id")
  deviceModel   String?        @map("device_model")
  osVersion     String?        @map("os_version")
  userAgent     String?        @map("user_agent")
  appVersion    String?        @map("app_version")
  lastIpAddress String?        @map("last_ip_address")
  lastActiveAt  DateTime?      @map("last_active_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pushToken])
  @@index([userId])
  @@map("devices")
}

model UserSecurityEvent {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  action      String
  ipAddress   String?         @map("ip_address")
  userAgent   String?         @map("user_agent")
  platform    DevicePlatform?
  deviceModel String?         @map("device_model")
  osVersion   String?         @map("os_version")
  appVersion  String?         @map("app_version")
  deviceId    String?         @map("device_id")
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("user_security_events")
}

enum IcebreakerSessionStatus {
  active
  matched
  expired
  cancelled
}

enum MatchSource {
  icebreaker
  wall_reply
  manual
  event
}

enum MatchStatus {
  pending
  active
  declined
  expired
}

enum ChatStatus {
  active
  closed
  blocked
}

model IcebreakerSession {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  latitude         Float
  longitude        Float
  showPhoto        Boolean                 @default(false) @map("show_photo")
  introMessage     String?                 @map("intro_message") @db.VarChar(100)
  status           IcebreakerSessionStatus @default(active)
  expiresAt        DateTime                @map("expires_at")
  matchedSessionId String?                 @map("matched_session_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([latitude, longitude])
  @@index([status, expiresAt])
  @@map("icebreaker_sessions")
}

model IcebreakerInterest {
  id                       String    @id @default(uuid()) @db.Uuid
  fromUserId               String    @map("from_user_id") @db.Uuid
  toUserId                 String    @map("to_user_id") @db.Uuid
  interested               Boolean
  hiddenUntil              DateTime? @map("hidden_until")
  expiresAt                DateTime? @map("expires_at")
  expiredAt                DateTime? @map("expired_at")
  unansweredAcknowledgedAt DateTime? @map("unanswered_acknowledged_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  fromUser User @relation("IcebreakerInterestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("IcebreakerInterestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([interested, expiresAt])
  @@map("icebreaker_interests")
}

model Match {
  id                String      @id @default(uuid()) @db.Uuid
  userAId           String      @map("user_a_id") @db.Uuid
  userBId           String      @map("user_b_id") @db.Uuid
  source            MatchSource
  sourceReferenceId String?     @map("source_reference_id") @db.Uuid
  status            MatchStatus @default(pending)
  userAAcceptedAt   DateTime?   @map("user_a_accepted_at")
  userBAcceptedAt   DateTime?   @map("user_b_accepted_at")
  expiresAt         DateTime    @map("expires_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  userA User  @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User  @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  chat  Chat?

  // Partial unique index matches_active_pair_uidx (pending|active) applied in migration —
  // Prisma cannot express partial unique indexes in @@unique.
  @@index([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  @@index([status, expiresAt])
  @@map("matches")
}

model Chat {
  id        String     @id @default(uuid()) @db.Uuid
  matchId   String     @unique @map("match_id") @db.Uuid
  status    ChatStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages Message[]
  participantStates ChatParticipantState[]

  @@map("chats")
}

model ChatParticipantState {
  userId       String    @map("user_id") @db.Uuid
  chatId       String    @map("chat_id") @db.Uuid
  hiddenAt     DateTime? @map("hidden_at")
  visibleAfter DateTime? @map("visible_after")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@map("chat_participant_states")
}

enum MessageType {
  text
  system
}

enum MessageStatus {
  sent
  delivered
  read
  deleted
}

model Message {
  id          String        @id @default(uuid()) @db.Uuid
  chatId      String        @map("chat_id") @db.Uuid
  senderId    String        @map("sender_id") @db.Uuid
  content     String        @db.VarChar(2000)
  messageType MessageType   @default(text) @map("message_type")
  status      MessageStatus @default(sent)
  createdAt   DateTime      @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("messages")
}

enum ReportTargetType {
  user
  post
  reply
  message
  event
  event_comment
}

enum EventStatus {
  active
  cancelled
  hidden
  deleted
  moderated
}

enum EventRsvpStatus {
  going
  maybe
  cancelled
}

enum EventCommentStatus {
  active
  hidden
  deleted
}

enum ReportReason {
  harassment
  spam
  inappropriate
  underage
  other
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

model Report {
  id              String           @id @default(uuid()) @db.Uuid
  reporterId      String           @map("reporter_id") @db.Uuid
  reportedUserId  String           @map("reported_user_id") @db.Uuid
  targetType      ReportTargetType @map("target_type")
  targetId        String           @map("target_id") @db.Uuid
  reason          ReportReason
  description     String?          @db.Text
  status          ReportStatus     @default(open)
  assignedToAdminId String?        @map("assigned_to_admin_id") @db.Uuid
  resolvedBy      String?          @map("resolved_by") @db.Uuid
  resolutionNote  String?          @map("resolution_note") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  resolvedAt      DateTime?        @map("resolved_at")

  reporter     User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  assignedTo   AdminUser? @relation("AssignedReports", fields: [assignedToAdminId], references: [id], onDelete: SetNull)

  @@unique([reporterId, reportedUserId])
  @@index([reportedUserId, createdAt])
  @@index([reporterId])
  @@map("reports")
}

enum VerificationType {
  liveness
  phone
  email
  document
}

enum VerificationProvider {
  didit
  twilio
}

enum VerificationStatus {
  pending
  passed
  failed
  expired
}

model Verification {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  type              VerificationType
  provider          VerificationProvider
  providerReference String?              @map("provider_reference") @db.VarChar(255)
  status            VerificationStatus   @default(pending)
  metadata          Json?
  verifiedAt        DateTime?            @map("verified_at")
  expiresAt         DateTime?            @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([providerReference])
  @@map("verifications")
}

enum AdminRole {
  super_admin
  moderator
  support
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole
  createdAt    DateTime  @default(now()) @map("created_at")

  auditLogs        AdminAuditLog[]
  assignedReports  Report[] @relation("AssignedReports")

  @@map("admin_users")
}

model AdminAuditLog {
  id          BigInt   @id @default(autoincrement())
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

enum SubscriptionPlan {
  free
  premium
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  trialing
}

enum PaymentProvider {
  manual
  stripe
  paddle
  revenuecat
}

model Subscription {
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @unique @map("user_id") @db.Uuid
  plan                   SubscriptionPlan    @default(free)
  status                 SubscriptionStatus  @default(active)
  paymentProvider        PaymentProvider?    @map("payment_provider")
  providerCustomerId     String?             @map("provider_customer_id") @db.VarChar(255)
  providerSubscriptionId String?             @map("provider_subscription_id") @db.VarChar(255)
  cancelAtPeriodEnd      Boolean             @default(false) @map("cancel_at_period_end")
  currentPeriodStart     DateTime?           @map("current_period_start")
  currentPeriodEnd       DateTime?           @map("current_period_end")
  metadata               Json?
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status])
  @@map("subscriptions")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  title          String      @db.VarChar(120)
  description    String      @db.Text
  latitude       Float
  longitude      Float
  placeName      String?     @map("place_name") @db.VarChar(200)
  address        String?     @db.VarChar(500)
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime    @map("ends_at")
  allowMessages  Boolean     @default(true) @map("allow_messages")
  status         EventStatus @default(active)
  goingCount     Int         @default(0) @map("going_count")
  maybeCount     Int         @default(0) @map("maybe_count")
  commentCount   Int         @default(0) @map("comment_count")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images   EventImage[]
  rsvps    EventRsvp[]
  comments EventComment[]

  @@index([latitude, longitude])
  @@index([status])
  @@index([startsAt])
  @@index([userId])
  @@map("events")
}

model EventImage {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  url       String   @db.VarChar(500)
  isCover   Boolean  @default(false) @map("is_cover")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_images")
}

model EventRsvp {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  status    EventRsvpStatus @default(going)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

model EventComment {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  content   String             @db.VarChar(500)
  status    EventCommentStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_comments")
}
