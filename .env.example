# Database (local Docker)
DATABASE_URL=postgresql://pingme:pingme@localhost:5435/pingme?schema=public

# Redis (local Docker)
REDIS_URL=redis://localhost:6381

# API
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=30
JWT_ADMIN_SECRET=change-me-admin-in-production
JWT_ADMIN_EXPIRES=8h

# Distance & icebreaker — served via GET /v1/config; restart API after changes.
DEFAULT_RADIUS_METERS=250              # Wall: default nearby radius (m) when user has no preference
WALL_MIN_RADIUS_METERS=150             # Wall: minimum radius users can pick (m)
WALL_MAX_RADIUS_METERS=500             # Wall: maximum radius users can pick (m)
ICEBREAKER_RADIUS_METERS=150           # Break the ice: max distance to see/be seen by others (m)
ICEBREAKER_STARTS_PER_HOUR=5           # Break the ice: max times a user can turn it on per hour
ICEBREAKER_WINDOW_MINUTES=10           # Break the ice: how long a session stays on before auto-off
ICEBREAKER_HIDE_MINUTES=10             # Break the ice: hide someone from your list after you tap No
ICEBREAKER_INTEREST_EXPIRY_MINUTES=10  # Break the ice: how long they have to respond to your Yes
EVENTS_DISCOVERY_RADIUS_METERS=15000     # Events: discovery search radius (m; future feature)
PRESENCE_TTL_SECONDS=300               # Wall visibility: seconds before "available" expires without a ping
# Push notifications (Expo push service)
PUSH_ENABLED=true                      # Send push notifications via Expo

# Email — SMTP (Hostinger) preferred; Resend fallback; console log in dev when unset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PingMe <support@hostyler.com>

# Email (Resend) — optional fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=PingMe <support@hostyler.com>

# SMS (Twilio) — optional in dev; logs OTP to console when unset
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Cloudflare R2 (avatar uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AVATARS=
R2_PUBLIC_URL=

# Public API base URL (used for locally stored avatar URLs when R2 is not configured)
API_PUBLIC_URL=http://localhost:3000/v1
UPLOADS_DIR=uploads

# Mobile Sentry (optional)
EXPO_PUBLIC_SENTRY_DSN=

# Didit.me liveness verification (Phase 6)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID_LIVENESS=e1139603-0c29-408e-9642-ae7166a3869b
DIDIT_WORKFLOW_ID_KYC=
DIDIT_API_BASE_URL=https://verification.didit.me/v3
DIDIT_CALLBACK_URL=pingme://verification-complete
DIDIT_WEBHOOK_EVENTS=

# Payments (Phase 8) — gateway-agnostic; set when provider is chosen
# Values: none | manual | stripe | paddle | revenuecat
PAYMENT_PROVIDER=none

# CORS (comma-separated). Required in production for browser clients (admin dashboard).
# Mobile/native clients omit Origin and are still allowed.
CORS_ORIGINS=https://admin.hostyler.cloud,https://pingme.hostyler.cloud

# Allow POST /notifications/test in production (default: false)
NOTIFICATIONS_TEST_ENABLED=false
